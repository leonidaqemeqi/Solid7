@startuml modello_dati_buby_v3
title Modello Dati SQLite (11 Tabelle Normalizzate) – Buby Solidale

skinparam packageStyle rectangle

package "1. Anagrafiche" {
  class PuntiRitiro {
    +id_punto: TEXT <<PK>>
    +nome: TEXT
    +zona: TEXT
    +capacita_max_kg: REAL
    +famiglie_assistite: INTEGER
  }
  class Donatori {
    +id_donatore: TEXT <<PK>>
    +nome_donatore: TEXT
    +tipologia_donatore: TEXT
  }
  class Volontari {
    +id_volontario: TEXT <<PK, HMAC>>
    +data_registrazione: TEXT
  }
  class Beneficiari {
    +id_beneficiario_anonimo: TEXT <<PK, HMAC>>
    +quartiere_riferimento: TEXT
  }
}

package "2. Operatività" {
  class Giacenze {
    +id_giacenza: TEXT <<PK>>
    +id_punto: TEXT <<FK>>
    +categoria: TEXT
    +quantita_attuale_kg: REAL
    +soglia_min_kg: REAL
  }
  class Donazioni {
    +id_donazione: TEXT <<PK>>
    +id_donatore: TEXT <<FK>>
    +id_punto_destinazione: TEXT <<FK>>
    +categoria: TEXT
    +quantita_kg: REAL
    +stato: TEXT
  }
  class Distribuzioni {
    +id_distribuzione: TEXT <<PK>>
    +id_punto: TEXT <<FK>>
    +id_beneficiario_anonimo: TEXT <<FK>>
    +kg_consegnati: REAL
  }
  class Turni {
    +id_turno: TEXT <<PK>>
    +id_punto: TEXT <<FK>>
    +id_volontario: TEXT <<FK, nullable>>
    +data_turno: TEXT
    +fascia_oraria: TEXT
    +stato: TEXT
  }
}

package "3. Comunicazioni AI" {
  class EmailDonatori {
    +id_email: TEXT <<PK>>
    +id_donatore: TEXT <<FK>>
    +urgenza: TEXT
    +nlp_intent: TEXT
  }
  class MessaggiVolontari {
    +id_messaggio: TEXT <<PK>>
    +id_volontario: TEXT <<FK>>
    +nlp_intent: TEXT
  }
  class NoteOperatori {
    +id_nota: TEXT <<PK>>
    +id_punto: TEXT <<FK>>
    +nlp_intent: TEXT
  }
}

' Relazioni Anagrafiche -> Operatività
PuntiRitiro "1" -- "0..*" Giacenze
PuntiRitiro "1" -- "0..*" Donazioni
PuntiRitiro "1" -- "0..*" Distribuzioni
PuntiRitiro "1" -- "0..*" Turni

Donatori "1" -- "0..*" Donazioni
Volontari "1" -- "0..*" Turni
Beneficiari "1" -- "0..*" Distribuzioni

' Relazioni Anagrafiche -> Comunicazioni
Donatori "1" -- "0..*" EmailDonatori
Volontari "1" -- "0..*" MessaggiVolontari
PuntiRitiro "1" -- "0..*" NoteOperatori

@enduml